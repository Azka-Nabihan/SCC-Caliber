# ==========================================
# SCC-Caliber Git Ignore Rules
# ==========================================

# Data Sensitif Pabrik (NDA PT Chandra Asri Pacific Tbk)
data/raw/
data/extracted/
data/**/*.xlsx
data/**/*.csv
data/**/*.zip
!data/processed/.gitkeep

# Dokumen Resmi Lomba & File PDF Besar
research/casebook/
research/papers/*.pdf
*.pdf

# Laporan Analisis Internal
research/reports/

# Scratch & Script Analisis Sementara
scratch/

# Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Environment variables & secrets
.env
.env.*
!.env.example

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
